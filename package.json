{
  "name": "dsh-draft-studio",
  "version": "1.2.3",

  "description": "你在输入框里随手打的一句还没想清楚的话，点一下，就变成 AI 真能照着干的完整指令。改完还是草稿，不会替你发出去；不满意一键还原。",
  "repository": { "type": "git", "url": "git+https://github.com/wufeng0105/dsh-draft-studio.git" },
  "homepage": "https://github.com/wufeng0105/dsh-draft-studio#readme",
  "bugs": { "url": "https://github.com/wufeng0105/dsh-draft-studio/issues" },
  "keywords": ["dsh", "dsh-plugin", "prompt", "composer", "prompt-engineering"],
  "type": "module",
  "scripts": {
    "self-check": "pwsh -NoProfile -File scripts/self-check.ps1",
    "check-version": "node scripts/check-version.mjs",
    "check-contract": "node scripts/contract-check.mjs"
  },
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/*.md",
    "scripts/*.ps1",
    "scripts/*.mjs",
    "!scripts/contract-check.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.0.0 || >=3.18.0-0 <4.0.0"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "license": "MIT"
}
