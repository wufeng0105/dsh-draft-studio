{
  "name": "dsh-draft-studio",
  "version": "1.2.0",

  "description": "Turn a half-formed draft in the composer into a prompt the AI can actually follow - rewritten in place, one click, never sent.",
  "repository": { "type": "git", "url": "git+https://github.com/wufeng0105/dsh-draft-studio.git" },
  "homepage": "https://github.com/wufeng0105/dsh-draft-studio#readme",
  "bugs": { "url": "https://github.com/wufeng0105/dsh-draft-studio/issues" },
  "keywords": ["dsh", "dsh-plugin", "prompt", "composer", "prompt-engineering"],
  "type": "module",
  "scripts": {
    "self-check": "pwsh -NoProfile -File scripts/self-check.ps1",
    "check-version": "node scripts/check-version.mjs"
  },
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/*.md",
    "scripts/*.ps1",
    "scripts/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.0.0 || >=3.18.0-0 <4.0.0"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "license": "MIT"
}
